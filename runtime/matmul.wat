(module
 (memory (export "memory") 1)
 (func (export "mul") (param $a i32) (param $b i32) (param $c i32) (param $m i32) (param $k i32) (param $n i32)
  (local $i i32) (local $j i32) (local $t i32) (local $ap i32) (local $bp i32) (local $cp i32) (local $x v128)
  (local $s0 v128)
(local $s1 v128)
(local $s2 v128)
(local $s3 v128)
  (local.set $i (i32.const 0))
  (block $done (loop $rows
   (br_if $done (i32.ge_u (local.get $i) (local.get $m)))
   (local.set $j (i32.const 0))
   (block $jdone (loop $cols
    (br_if $jdone (i32.ge_u (local.get $j) (local.get $n)))
    (local.set $s0 (v128.const f32x4 0 0 0 0))
(local.set $s1 (v128.const f32x4 0 0 0 0))
(local.set $s2 (v128.const f32x4 0 0 0 0))
(local.set $s3 (v128.const f32x4 0 0 0 0))
    (local.set $t (i32.const 0))
    (local.set $ap (i32.add (local.get $a) (i32.shl (i32.mul (local.get $i) (local.get $k)) (i32.const 2))))
    (local.set $bp (i32.add (local.get $b) (i32.shl (local.get $j) (i32.const 2))))
    (block $kdone (loop $inner
     (br_if $kdone (i32.ge_u (local.get $t) (local.get $k)))
     (local.set $x (v128.load32_splat (local.get $ap)))
     (local.set $s0 (f32x4.add (local.get $s0) (f32x4.mul (local.get $x) (v128.load offset=0 (local.get $bp)))))
(local.set $s1 (f32x4.add (local.get $s1) (f32x4.mul (local.get $x) (v128.load offset=16 (local.get $bp)))))
(local.set $s2 (f32x4.add (local.get $s2) (f32x4.mul (local.get $x) (v128.load offset=32 (local.get $bp)))))
(local.set $s3 (f32x4.add (local.get $s3) (f32x4.mul (local.get $x) (v128.load offset=48 (local.get $bp)))))
     (local.set $ap (i32.add (local.get $ap) (i32.const 4)))
     (local.set $bp (i32.add (local.get $bp) (i32.shl (local.get $n) (i32.const 2))))
     (local.set $t (i32.add (local.get $t) (i32.const 1))) (br $inner)))
    (local.set $cp (i32.add (local.get $c) (i32.shl (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $j)) (i32.const 2))))
    (v128.store offset=0 (local.get $cp) (local.get $s0))
(v128.store offset=16 (local.get $cp) (local.get $s1))
(v128.store offset=32 (local.get $cp) (local.get $s2))
(v128.store offset=48 (local.get $cp) (local.get $s3))
    (local.set $j (i32.add (local.get $j) (i32.const 16))) (br $cols)))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $rows))))
)